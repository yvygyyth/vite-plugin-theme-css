{
  "name": "vite-plugin-theme-css",
  "version": "0.2.0",
  "description": "Vite 插件：用一份主题配置生成 CSS 变量、SCSS helper 与 JS 运行时，支持多主题切换与热更新",
  "author": "yuzinan <1589937631@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yvygyyth/theme-css.git"
  },
  "homepage": "https://github.com/yvygyyth/theme-css#readme",
  "bugs": {
    "url": "https://github.com/yvygyyth/theme-css/issues"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "theme",
    "css",
    "css-variables",
    "scss",
    "dark-mode",
    "theme-switcher"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "play": "vite --config playground/vite.config.ts",
    "test": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm publish --access public"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "prettier": "3.9.6",
    "sass": "^1.103.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}